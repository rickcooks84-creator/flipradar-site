{
  "manifest_version": 3,
  "name": "FlipSonar eBay Connector",
  "version": "1.0.0",
  "description": "Lets flipsonar.io read eBay sold prices through your own signed-in eBay session. Your eBay login never leaves your browser.",
  "minimum_chrome_version": "102",
  "host_permissions": ["https://*.ebay.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://flipsonar.io/*",
        "https://www.flipsonar.io/*",
        "http://localhost:3000/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FlipSonar eBay Connector",
    "default_icon": { "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon128.png", "48": "icons/icon128.png", "128": "icons/icon128.png" }
}
